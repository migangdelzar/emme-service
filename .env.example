# EMME Modulith — Local Development Environment
# Copy to .env and fill in values

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emme
DB_USERNAME=emme
DB_PASSWORD=emme

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Keycloak ──
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=emme

# ── AI ──
APP_AI_PROVIDER=mock
# APP_AI_PROVIDER=ollama  # switch when Ollama is available
# APP_AI_PROVIDER=groq    # switch for free-tier Groq cloud AI
OLLAMA_HOST=http://localhost:11434
# Groq AI (free tier — llama-3.3-70b, ~30 req/min)
GROQ_API_KEY=

# ── Payment ──
APP_PAYMENT_PROVIDER=mock
# MercadoPago (sandbox)
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=
# Conekta (Mexican payment gateway)
# CONEKTA_PRIVATE_KEY=
# CONEKTA_WEBHOOK_SECRET=
# PayPal
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Notification ──
# Email
APP_NOTIFICATION_EMAIL_PROVIDER=mock
# SMTP (e.g. Gmail with app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SendGrid
# SENDGRID_API_KEY=
# AWS SES
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SMS
APP_NOTIFICATION_SMS_PROVIDER=mock
# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MessageBird
# MESSAGEBIRD_API_KEY=
# Vonage
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# Push
APP_NOTIFICATION_PUSH_PROVIDER=mock
# FCM (Firebase Cloud Messaging)
# FCM_SERVICE_ACCOUNT_BASE64=
# APNs (Apple Push Notification service)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY_BASE64=
# APNS_BUNDLE_ID=com.emme.salon

# ── Google Calendar ──
# Base64-encoded Google service account JSON (for Google Calendar sync)
# GOOGLE_SA_JSON_BASE64=
# GOOGLE_CALENDAR_ID=

# ── WhatsApp Cloud API ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=emme_verify_token

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Frontend ──
VITE_API_URL=http://localhost:8081
VITE_KEYCLOAK_URL=http://localhost:8080
